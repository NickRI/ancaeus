[Unit]
Description=Ancaeus Wi-Fi geolocation provider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ancaeus --listen 127.0.0.1:1223 --provider beacondb
# Google: --provider google --google-geo-token-file /etc/ancaeus/google-geo.token
# Self-hosted beaconDB: --beacondb-url http://127.0.0.1:8080/v1/geolocate
CacheDirectory=ancaeus
Restart=on-failure
DynamicUser=yes
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
